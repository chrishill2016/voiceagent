<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">Your name is shown on the call. It's remembered on this device.</MudText>
        <MudTextField @bind-Value="_name" Label="Your name" AutoFocus="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_name)"
                   OnClick="() => Dialog.Close(DialogResult.Ok(_name.Trim()))">Continue</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _name = string.Empty;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
}
