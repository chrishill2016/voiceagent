@inject ICallsApi Api
@inject AgentProfile Profile
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudTooltip Text="@Hint" Disabled="@(Hint is null)">
    <MudButton Variant="@(Call.Stage == CallStage.QueuedForAgent ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" Size="@Size" StartIcon="@Icons.Material.Filled.SupportAgent"
               Disabled="@(_busy || Call.Stage is CallStage.WithAgent or CallStage.Ended)"
               OnClick="TakeAsync" data-testid="take-call">
        @(Call.Stage == CallStage.QueuedForAgent ? "Take call" : "Take over")
    </MudButton>
</MudTooltip>

@code {
    private bool _busy;

    [Parameter, EditorRequired] public CallSummary Call { get; set; } = default!;
    [Parameter] public Size Size { get; set; } = Size.Small;

    private string? Hint => Profile.Current switch
    {
        null => "Set up your agent profile to take calls",
        { Status: not AgentStatus.Available } when Call.OfferedToAgentId != Profile.AgentId => "Set yourself to Available to take calls",
        _ => null,
    };

    private async Task TakeAsync()
    {
        if (Profile.Current is null)
        {
            var dialog = await Dialogs.ShowAsync<AgentProfileDialog>("Who are you?");
            if (await dialog.Result is not { Canceled: false, Data: AgentInfo agent }) return;
            await Profile.SetAsync(agent.Id);
        }

        _busy = true;
        try
        {
            var result = await Api.TakeCallAsync(Call.Id, Profile.AgentId!);
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Couldn't reach the server. Try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
