@page "/sample-data"
@inject ICallsApi Api

<PageTitle>Sample cases</PageTitle>

<MudText Typo="Typo.h4" id="h1" Class="mb-2">Sample cases</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4">
    Fictional clients and conveyancing cases, including the answers to the security questions, so you can test calls.
    Find a case by <b>case number</b>, or by <b>postcode and surname</b>. Security is the full name of anyone on the account,
    the previous lender, and the date of birth of anyone on the account.
    Turn this page off in production with <code>Demo__ShowSampleData=false</code>.
</MudAlert>

<MudTable Items="_cases" Loading="_loading" Dense="true" Elevation="1" data-testid="sample-cases">
    <HeaderContent>
        <MudTh>Case number</MudTh>
        <MudTh>People on the account</MudTh>
        <MudTh>Previous lender</MudTh>
        <MudTh>Postcodes</MudTh>
        <MudTh>Matter</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Case number"><b>@context.CaseNumber</b></MudTd>
        <MudTd DataLabel="People on the account">
            @foreach (var party in context.Parties)
            {
                <div>@party.FullName · born @party.DateOfBirth.ToString("d MMMM yyyy")</div>
            }
        </MudTd>
        <MudTd DataLabel="Previous lender">@(context.PreviousLender ?? "None (first-time buyer)")</MudTd>
        <MudTd DataLabel="Postcodes">
            <div>Property: @context.PropertyPostcode</div>
            <div>Home: @context.Postcode</div>
        </MudTd>
        <MudTd DataLabel="Matter">
            <div>@context.MatterType · @context.Stage</div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.PropertyAddress</MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>Sample data is turned off.</MudText></NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<DemoCase> _cases = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _cases = await Api.GetDemoCasesAsync();
        _loading = false;
    }
}
